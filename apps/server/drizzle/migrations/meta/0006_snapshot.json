      "indexes": {},
      "foreignKeys": {},
      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "policies": {},
      "checkConstraints": {
        "queue_settings_queue_check": {
          "name": "queue_settings_queue_check",
          "value": "\"infra\".\"queue_settings\".\"queue\" IN ('publish', 'media', 'ai_batch', 'trends', 'notify', 'scheduled')"
        },
        "queue_settings_concurrency_check": {
          "name": "queue_settings_concurrency_check",
          "value": "\"infra\".\"queue_settings\".\"concurrency_per_worker\" >= 1 AND \"infra\".\"queue_settings\".\"concurrency_per_worker\" <= 50"
        },
        "queue_settings_max_per_tenant_check": {
          "name": "queue_settings_max_per_tenant_check",
          "value": "\"infra\".\"queue_settings\".\"max_per_tenant\" IS NULL OR (\"infra\".\"queue_settings\".\"max_per_tenant\" >= 1 AND \"infra\".\"queue_settings\".\"max_per_tenant\" <= \"infra\".\"queue_settings\".\"concurrency_per_worker\" * 10)"
        },
        "queue_settings_lock_seconds_check": {
          "name": "queue_settings_lock_seconds_check",
          "value": "\"infra\".\"queue_settings\".\"lock_seconds\" >= 30 AND \"infra\".\"queue_settings\".\"lock_seconds\" <= 3600"
        },
        "queue_settings_heartbeat_seconds_check": {
          "name": "queue_settings_heartbeat_seconds_check",
          "value": "\"infra\".\"queue_settings\".\"heartbeat_seconds\" >= 10 AND \"infra\".\"queue_settings\".\"heartbeat_seconds\" < \"infra\".\"queue_settings\".\"lock_seconds\""
        },
        "queue_settings_retry_mode_check": {
          "name": "queue_settings_retry_mode_check",
          "value": "\"infra\".\"queue_settings\".\"retry_mode\" IN ('schedule', 'handler', 'none')"
        },
        "queue_settings_max_retries_check": {
          "name": "queue_settings_max_retries_check",
          "value": "\"infra\".\"queue_settings\".\"max_retries\" >= 0 AND \"infra\".\"queue_settings\".\"max_retries\" <= 20 AND (\"infra\".\"queue_settings\".\"retry_mode\" <> 'none' OR \"infra\".\"queue_settings\".\"max_retries\" = 0)"
        },
        "queue_settings_retry_delays_check": {
          "name": "queue_settings_retry_delays_check",
          "value": "cardinality(\"infra\".\"queue_settings\".\"retry_delays_seconds\") >= 1 AND array_position(\"infra\".\"queue_settings\".\"retry_delays_seconds\", NULL) IS NULL AND 1 <= ALL(\"infra\".\"queue_settings\".\"retry_delays_seconds\") AND 86400 >= ALL(\"infra\".\"queue_settings\".\"retry_delays_seconds\")"
        },
        "queue_settings_poll_interval_check": {
          "name": "queue_settings_poll_interval_check",
          "value": "\"infra\".\"queue_settings\".\"poll_interval_ms\" >= 200 AND \"infra\".\"queue_settings\".\"poll_interval_ms\" <= 60000"
        }
      },
      "isRLSEnabled": false
    }
