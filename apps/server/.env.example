# Cấu hình môi trường của API và Worker (data-model.md mục 3).
# Sao chép thành .env để chạy dev: Copy-Item apps/server/.env.example apps/server/.env
# KHÔNG commit .env. Biến bí mật (CSDL, kho tệp, KMS…) do WBS 1.2/1.5 thêm.

# Môi trường chạy (bắt buộc): development | test | staging | production
APP_ENV=development

# Phiên bản ứng dụng, hiện trong /healthz và nhật ký
APP_VERSION=0.0.0-dev

# Cổng HTTP của API (1–65535)
API_PORT=3000

# Cổng kiểm tra sống của Worker (1–65535) – chỉ có GET /healthz
WORKER_HEALTH_PORT=3001

# Thời gian chờ tối đa việc đang chạy khi tắt, mili giây (1000–60000)
SHUTDOWN_TIMEOUT_MS=30000

# Mức nhật ký: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Nguồn được phép gọi API từ trình duyệt, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173
