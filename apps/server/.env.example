# Cấu hình môi trường của API và Worker (data-model.md mục 3).
# Sao chép thành .env để chạy dev: Copy-Item apps/server/.env.example apps/server/.env
# KHÔNG commit .env. Biến bí mật kho tệp, KMS… do WBS 1.5 thêm.

# Môi trường chạy (bắt buộc): development | test | staging | production
APP_ENV=development

# Phiên bản ứng dụng, hiện trong /healthz và nhật ký
APP_VERSION=0.0.0-dev

# Cổng HTTP của API (1–65535)
API_PORT=3000

# Cổng kiểm tra sống của Worker (1–65535) – chỉ có GET /healthz
WORKER_HEALTH_PORT=3001

# Thời gian chờ tối đa việc đang chạy khi tắt, mili giây (1000–60000)
SHUTDOWN_TIMEOUT_MS=30000

# Mức nhật ký: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Nguồn được phép gọi API từ trình duyệt, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173

# ===== CSDL (WBS 1.2) – contracts/db-commands.md mục 2 =====
# Giá trị *_dev_only CHỈ dùng cục bộ với PostgreSQL của docker compose (pnpm db:up),
# KHÔNG BAO GIỜ dùng ở môi trường thật. Mọi URL/mật khẩu là bí mật – không in, không ghi nhật ký.

# API + Worker: vai trò "app" (bắt buộc) – chịu Row-Level Security
DATABASE_APP_URL=postgres://app:app_dev_only@localhost:5432/app
# Worker: vai trò "system" (bắt buộc ở Worker; API không dùng)
DATABASE_SYSTEM_URL=postgres://system:system_dev_only@localhost:5432/app
# API: vai trò "support" (tùy chọn – thiếu thì thao tác hỗ trợ trả SERVICE_UNAVAILABLE)
DATABASE_SUPPORT_URL=postgres://support:support_dev_only@localhost:5432/app
# Số kết nối tối đa mỗi bể (1–100)
DATABASE_POOL_MAX=10
# statement_timeout, mili giây (≥ 1000)
DATABASE_STATEMENT_TIMEOUT_MS=15000
# idle_in_transaction_session_timeout, mili giây (≥ 1000)
DATABASE_IDLE_IN_TX_TIMEOUT_MS=30000

# ===== Xác thực (WBS 2.1 – specs/004-minimal-auth-rbac/contracts/auth-ops.md mục 1) =====
# Chỉ API đọc các biến này; Worker bỏ qua. Giá trị dev_only CHỈ dùng cục bộ.

# URL gốc của SPA để dựng liên kết trong thư (bắt buộc ở API)
WEB_BASE_URL=http://localhost:5173
# Nguồn được gửi yêu cầu thay đổi dữ liệu (chống CSRF); mặc định = gốc của WEB_BASE_URL
# WEB_ORIGINS=http://localhost:5173
# Số proxy tin cậy để lấy địa chỉ mạng thật; mặc định 0 ở development, 1 ở staging/production
# TRUST_PROXY_HOPS=0
# Khóa HMAC cho bộ đếm chống dò (bí mật, ≥ 32 byte, bắt buộc ở API)
AUTH_THROTTLE_SECRET=dev_only_auth_throttle_secret_0123456789abcdef
# Phiên khách hàng: hết hạn khi không hoạt động / tuyệt đối (ngày)
# SESSION_IDLE_DAYS=14
# SESSION_ABSOLUTE_DAYS=30
# Phiên nhân viên nội bộ: không hoạt động (phút) / tuyệt đối (giờ)
# STAFF_SESSION_IDLE_MINUTES=30
# STAFF_SESSION_ABSOLUTE_HOURS=12
# Dải mạng được vào lối nội bộ, vd 10.0.0.0/8,203.0.113.4/32; để trống = không giới hạn
# STAFF_ALLOWED_CIDRS=
# Chống dò mật khẩu: số lần sai theo email / theo địa chỉ mạng, cửa sổ đếm và thời gian chặn (phút)
# LOGIN_MAX_FAILURES_PER_EMAIL=5
# LOGIN_MAX_FAILURES_PER_IP=30
# LOGIN_WINDOW_MINUTES=15
# LOGIN_BLOCK_MINUTES=15
# Tham số argon2id (OWASP 2024)
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2
# Phiên bản điều khoản sử dụng hiện hành (bắt buộc ở API)
TERMS_VERSION=2026-11
# Cách gửi thư: smtp | memory (memory chỉ cho kiểm thử, bị từ chối ở production)
MAIL_TRANSPORT=smtp
# Máy chủ SMTP (bí mật). Dev: Mailpit của docker compose (pnpm db:up), xem thư ở http://localhost:8025
SMTP_URL=smtp://localhost:1025
# Địa chỉ người gửi
MAIL_FROM='"App" <no-reply@example.test>'
# ===== Đăng nhập Google/Facebook, lời mời, tài khoản chờ (009 – contracts/module-api.md mục 6) =====
# Nhà cung cấp đăng nhập: real | fake. fake = trang giả lập /api/v1/dev/oauth/fake/authorize, CHỈ dùng ở
# development/test (staging/production từ chối khởi động). Không đặt ở staging/production = chưa bật.
OAUTH_DRIVER=fake
# Bắt buộc khi OAUTH_DRIVER=real; lấy từ kho bí mật – KHÔNG ghi giá trị thật vào tệp này.
# Địa chỉ quay về đăng ký với nhà cung cấp: {WEB_BASE_URL}/api/v1/auth/oauth/{google|facebook}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
# Cũng dùng để kiểm chữ ký thông báo gỡ ứng dụng / xóa dữ liệu của Meta
FACEBOOK_APP_SECRET=
# Phiên bản Graph API cho lời gọi lấy hồ sơ Facebook
# FACEBOOK_GRAPH_VERSION=v21.0
# Hạn vòng đi – về với nhà cung cấp / hạn bước xác nhận liên kết / cửa sổ "mới xác nhận lại danh tính" (phút)
# OAUTH_FLOW_TTL_MINUTES=10
# LINK_CONFIRM_TTL_MINUTES=30
# REAUTH_WINDOW_MINUTES=10
# Lời mời cộng tác viên: hạn (ngày) và số lời mời mới tối đa mỗi tài khoản mỗi ngày
# INVITE_TTL_DAYS=7
# INVITE_MAX_PER_ACCOUNT_PER_DAY=10
# Người không thuộc tài khoản nào: xóa sau (ngày) và báo trước (ngày)
# DETACHED_RETENTION_DAYS=90
# DETACHED_NOTICE_DAYS=7
# ===== Hàng chờ (WBS 1.3) – contracts/queue-commands.md mục 2 =====
# Worker lấy việc hay không: true | false (false chỉ để gỡ lỗi)
QUEUE_ENABLED=true
# Bể điều khiển hàng chờ của Worker – vai trò "system" (2–20)
QUEUE_CONTROL_POOL_MAX=6
# Bể của pg-boss phía API – vai trò "app", chỉ đọc bộ nhớ đệm hàng chờ (1–5)
QUEUE_API_POOL_MAX=2
# Chu kỳ đọc lại infra.queue_settings, mili giây (10000–300000)
QUEUE_SETTINGS_REFRESH_MS=60000
# Mã kiểm tra khói sau triển khai (008): đặt thì bật POST/GET /ops/smoke (tiêu đề X-Smoke-Token); bỏ trống = 404.
# Chỉ đặt ở môi trường staging/production qua Secret, KHÔNG ghi giá trị thật vào kho mã.
# SMOKE_TOKEN=
# Nhịp bộ hẹn giờ việc định kỳ, mili giây (1000–30000)
QUEUE_SCHEDULER_TICK_MS=10000
# Worker nên đặt DATABASE_POOL_MAX >= 20 (tổng đồng thời/bản = 26)

# ----- Chỉ cho script CSDL (pnpm db:bootstrap / db:migrate / db:check) – API/Worker KHÔNG đọc -----
# Tài khoản quản trị cụm, chỉ để tạo vai trò (db:bootstrap)
DATABASE_ADMIN_URL=postgres://postgres:postgres_dev_only@localhost:5432/app
# Vai trò "owner" – chủ mọi schema/bảng, chạy migration và db:check
DATABASE_OWNER_URL=postgres://owner:owner_dev_only@localhost:5432/app
# Mật khẩu 4 vai trò do db:bootstrap đặt
DB_ROLE_PASSWORD_OWNER=owner_dev_only
DB_ROLE_PASSWORD_APP=app_dev_only
DB_ROLE_PASSWORD_SYSTEM=system_dev_only
DB_ROLE_PASSWORD_SUPPORT=support_dev_only

# ----- Kiểm thử tích hợp CSDL (pnpm test:db) – tạo CSDL tạm app_test_<ngẫu nhiên> -----
# Đặt biến này trong shell khi chạy test:db (vitest không đọc .env):
# TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres_dev_only@localhost:5432/postgres

# ===== Cổng + bản giả lập (005 – specs/005-gateway-contracts-fakes/contracts/runtime-config.md) =====
# Bản giả lập CHỈ được dùng khi APP_ENV ∈ {development, test}; staging/production từ chối khởi động.
# Cổng nền tảng / Cổng AI / Thông báo: hiện chỉ có `fake` (bản thật: WBS 2.3 / 3.1 / 4.3)
PLATFORM_GATEWAY_DRIVER=fake
AI_GATEWAY_DRIVER=fake
NOTIFICATIONS_DRIVER=fake
# Nơi bản giả lập giữ trạng thái: memory (mỗi tiến trình riêng – chỉ kiểm thử) | sandbox (schema sandbox, API + Worker thấy chung)
FAKE_STATE_STORE=sandbox
# Chỉ có hiệu lực khi APP_ENV=staging; production bỏ qua (007, R15). `true` cho phép driver `fake` của ba cổng ở
# thử nghiệm (chỉ với FAKE_STATE_STORE=sandbox) cho đến khi có bản thật. Ví dụ thử nghiệm:
#   APP_ENV=staging  STAGING_ALLOW_FAKES=true  FAKE_STATE_STORE=sandbox  PLATFORM_GATEWAY_DRIVER=fake ...
# STORAGE_DRIVER=memory và MAIL_TRANSPORT=memory vẫn bị từ chối. Bỏ dòng này (hoặc `false`) = như cũ.
STAGING_ALLOW_FAKES=false

# ===== Bài viết, duyệt, lịch (012 – specs/012-manual-compose-approval-calendar/contracts/module-api.md mục 6) =====
# Giờ đăng tối thiểu kể từ bây giờ (phút) – FR-011
POST_MIN_LEAD_MINUTES=5
# "Giờ vàng" gợi ý khi duyệt (giờ UTC+7, HH:MM cách nhau bằng dấu phẩy)
POST_SUGGEST_HOURS=09:00,12:00,19:00
# Tối đa số bài mỗi lần duyệt / trả lại hàng loạt, và mỗi lần gửi duyệt
POST_BULK_APPROVE_LIMIT=100
POST_BULK_SUBMIT_LIMIT=50
# Bộ thực thi 5 bước của việc đăng bài (013): none (hoãn việc 15 phút, không đổi trạng thái – an toàn khi chưa muốn đăng)
# | run (đăng thật qua Cổng nền tảng; bộ chuyển đổi thật hay giả do PLATFORM_ADAPTER_MODE/PLATFORM_GATEWAY_DRIVER quyết định)
# | fake (bí danh cũ của 012, chạy như run; production từ chối; staging cần STAGING_ALLOW_FAKES=true)
PUBLISH_EXECUTOR=none
# Thư viện media (014): hạn mức dung lượng/tài khoản (byte, mặc định 5 GiB), hạn đường dẫn công khai cho nền tảng
# (giây, trần 86400) và đường dẫn xem trước cho giao diện (giây, trần 3600).
# MEDIA_QUOTA_BYTES=5368709120
# MEDIA_PUBLIC_URL_TTL_SEC=86400
# MEDIA_PREVIEW_URL_TTL_SEC=3600
# Bộ chuyển đổi Facebook Page/Instagram THẬT (013): real | để trống (dùng bản giả theo PLATFORM_GATEWAY_DRIVER).
# Cần kết nối kênh thật (tính năng 010) mới đăng được; production không được dùng fake.
# PLATFORM_ADAPTER_MODE=real
# META_GRAPH_VERSION=v21.0
# META_GRAPH_BASE_URL=https://graph.facebook.com
# META_GRAPH_TIMEOUT_MS=25000
# Đối soát bằng đọc lại bài gần đây: tắt tới khi POC-2 xác nhận (tắt → bài mơ hồ chuyển "Cần kiểm tra")
# META_FACEBOOK_RECONCILE=false
# META_INSTAGRAM_RECONCILE=false
# Giới hạn dung lượng video Facebook (byte) – 1 GB theo quyết định của PO (2026-11-16)
# FACEBOOK_VIDEO_MAX_BYTES=1000000000
# Kho tệp: memory (kiểm thử) | s3 (dev: MinIO của docker compose, console http://localhost:9001)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
# Địa chỉ ký đường dẫn cho trình duyệt/nền tảng; mặc định = S3_ENDPOINT
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=app-dev
# Khóa truy cập S3 (bí mật). Giá trị *_dev_only CHỈ dùng với MinIO cục bộ.
S3_ACCESS_KEY_ID=minio_dev_only
S3_SECRET_ACCESS_KEY=minio_secret_dev_only
# true cho MinIO (đường dẫn dạng /bucket/key)
S3_FORCE_PATH_STYLE=true
# Trần chi phí AI của việc hệ thống (xu hướng) mỗi tuần, micro-USD (mặc định 2 000 000 = 2 USD)
# AI_SYSTEM_WEEKLY_CAP_MICRO_USD=2000000
# Thời gian chờ phản hồi khi gửi bài lên nền tảng, mili giây (5000–120000)
# PLATFORM_SUBMIT_TIMEOUT_MS=30000
# Thời gian chờ nhà cung cấp AI (một lần) và chữ đầu tiên (trả dần), mili giây
# AI_PROVIDER_TIMEOUT_MS=40000
# AI_FIRST_TOKEN_TIMEOUT_MS=5000
