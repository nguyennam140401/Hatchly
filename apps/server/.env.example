# Cấu hình môi trường của API và Worker (data-model.md mục 3).
# Sao chép thành .env để chạy dev: Copy-Item apps/server/.env.example apps/server/.env
# KHÔNG commit .env. Biến bí mật kho tệp, KMS… do WBS 1.5 thêm.

# Môi trường chạy (bắt buộc): development | test | staging | production
APP_ENV=development

# Phiên bản ứng dụng, hiện trong /healthz và nhật ký
APP_VERSION=0.0.0-dev

# Cổng HTTP của API (1–65535)
API_PORT=3000

# Cổng kiểm tra sống của Worker (1–65535) – chỉ có GET /healthz
WORKER_HEALTH_PORT=3001

# Thời gian chờ tối đa việc đang chạy khi tắt, mili giây (1000–60000)
SHUTDOWN_TIMEOUT_MS=30000

# Mức nhật ký: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Nguồn được phép gọi API từ trình duyệt, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173

# ===== CSDL (WBS 1.2) – contracts/db-commands.md mục 2 =====
# Giá trị *_dev_only CHỈ dùng cục bộ với PostgreSQL của docker compose (pnpm db:up),
# KHÔNG BAO GIỜ dùng ở môi trường thật. Mọi URL/mật khẩu là bí mật – không in, không ghi nhật ký.

# API + Worker: vai trò "app" (bắt buộc) – chịu Row-Level Security
DATABASE_APP_URL=postgres://app:app_dev_only@localhost:5432/app
# Worker: vai trò "system" (bắt buộc ở Worker; API không dùng)
DATABASE_SYSTEM_URL=postgres://system:system_dev_only@localhost:5432/app
# API: vai trò "support" (tùy chọn – thiếu thì thao tác hỗ trợ trả SERVICE_UNAVAILABLE)
DATABASE_SUPPORT_URL=postgres://support:support_dev_only@localhost:5432/app
# Số kết nối tối đa mỗi bể (1–100)
DATABASE_POOL_MAX=10
# statement_timeout, mili giây (≥ 1000)
DATABASE_STATEMENT_TIMEOUT_MS=15000
# idle_in_transaction_session_timeout, mili giây (≥ 1000)
DATABASE_IDLE_IN_TX_TIMEOUT_MS=30000

# ===== Hàng chờ (WBS 1.3) – contracts/queue-commands.md mục 2 =====
# Worker lấy việc hay không: true | false (false chỉ để gỡ lỗi)
QUEUE_ENABLED=true
# Bể điều khiển hàng chờ của Worker – vai trò "system" (2–20)
QUEUE_CONTROL_POOL_MAX=6
# Bể của pg-boss phía API – vai trò "app", chỉ đọc bộ nhớ đệm hàng chờ (1–5)
QUEUE_API_POOL_MAX=2
# Chu kỳ đọc lại infra.queue_settings, mili giây (10000–300000)
QUEUE_SETTINGS_REFRESH_MS=60000
# Nhịp bộ hẹn giờ việc định kỳ, mili giây (1000–30000)
QUEUE_SCHEDULER_TICK_MS=10000
# Worker nên đặt DATABASE_POOL_MAX >= 20 (tổng đồng thời/bản = 26)

# ----- Chỉ cho script CSDL (pnpm db:bootstrap / db:migrate / db:check) – API/Worker KHÔNG đọc -----
# Tài khoản quản trị cụm, chỉ để tạo vai trò (db:bootstrap)
DATABASE_ADMIN_URL=postgres://postgres:postgres_dev_only@localhost:5432/app
# Vai trò "owner" – chủ mọi schema/bảng, chạy migration và db:check
DATABASE_OWNER_URL=postgres://owner:owner_dev_only@localhost:5432/app
# Mật khẩu 4 vai trò do db:bootstrap đặt
DB_ROLE_PASSWORD_OWNER=owner_dev_only
DB_ROLE_PASSWORD_APP=app_dev_only
DB_ROLE_PASSWORD_SYSTEM=system_dev_only
DB_ROLE_PASSWORD_SUPPORT=support_dev_only

# ----- Kiểm thử tích hợp CSDL (pnpm test:db) – tạo CSDL tạm app_test_<ngẫu nhiên> -----
# Đặt biến này trong shell khi chạy test:db (vitest không đọc .env):
# TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres_dev_only@localhost:5432/postgres
