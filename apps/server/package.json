{
  "name": "@app/server",
  "version": "0.0.0",
  "private": true,
  "description": "API và Worker – một mã nguồn, hai điểm khởi động (ADR-01)",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev:api": "tsx watch --env-file=.env src/api.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "test:linux": "node scripts/test-linux.mjs"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
