{
  "name": "@app/server",
  "version": "0.0.0",
  "private": true,
  "description": "API và Worker – một mã nguồn, hai điểm khởi động (ADR-01)",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev:api": "tsx watch --env-file=.env src/api.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "test:linux": "node scripts/test-linux.mjs",
    "db:bootstrap": "tsx --env-file-if-exists=.env src/db/bootstrap.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:setup": "tsx --env-file-if-exists=.env src/db/setup-dev.ts",
    "db:check": "tsx --env-file-if-exists=.env src/db/check-conventions.ts",
    "db:lint-migrations": "tsx src/db/lint-migrations.ts",
    "db:immutable": "tsx src/db/check-immutable.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:generate:custom": "drizzle-kit generate --custom --config drizzle.config.ts",
    "db:generate:dev": "drizzle-kit generate --config drizzle.dev.config.ts",
    "test:db": "vitest run --config vitest.db.config.mts",
    "staff": "tsx --env-file-if-exists=.env src/ops/staff.ts",
    "dev:seed-auth": "tsx --env-file-if-exists=.env src/ops/seed-auth.ts",
    "test:queue": "vitest run --config vitest.queue.config.mts",
    "test:compat": "node scripts/test-compat.mjs",
    "test:infra": "vitest run --config vitest.infra.config.mts",
    "test:e2e-fakes": "vitest run --config vitest.db.config.mts test/e2e/fakes-flow.e2e.spec.ts",
    "test:queue-soak": "vitest run --config vitest.queue.config.mts test/queue/soak",
    "queue:sql": "tsx src/db/queue-sql.ts"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@aws-sdk/client-s3": "3.1158.0",
    "@aws-sdk/s3-presigned-post": "3.1158.0",
    "@aws-sdk/s3-request-presigner": "3.1158.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@node-rs/argon2": "2.2.2",
    "@opentelemetry/api": "1.9.0",
    "cron-parser": "5.10.2",
    "drizzle-orm": "0.45.4",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.4.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
