{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "rootDir": ".",
    "outDir": "dist-types",
    "types": ["node"]
  },
  "include": [
    "src",
    "src/**/*.json",
    "test",
    "scripts",
    "vitest.config.mts",
    "vitest.infra.config.mts",
    "vitest.db.config.mts",
    "vitest.queue.config.mts",
    "drizzle.config.ts",
    "drizzle.dev.config.ts"
  ]
}
