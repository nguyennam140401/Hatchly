# Nơi DUY NHẤT ghi phiên bản công cụ của quy trình tích hợp – triển khai (008, R19).
# Cách cập nhật: mở pull request sửa tệp này – tra bản phát hành hiện hành và mã băm SHA-256 ở trang
# chính thức của từng công cụ (đường dẫn ghi cạnh mỗi mục); `pnpm check:pipeline` kiểm đủ trường.
# `ops/ci/vm/bootstrap.sh` tải đúng phiên bản và so mã băm trước khi cài.

# https://get.helm.sh/helm-<phiên bản>-linux-amd64.tar.gz.sha256sum
HELM_VERSION=v4.3.2
HELM_SHA256_LINUX_AMD64=d1c0278d46beab79582d7e50f5b3dc206944ba8e577cde618513fd07daa53983

# https://dl.k8s.io/release/<phiên bản>/bin/linux/amd64/kubectl.sha256
KUBECTL_VERSION=v1.37.2
KUBECTL_SHA256_LINUX_AMD64=c04487523e7aa7d1493f7808174c899db93d7a9cf57531420cd76b9bd415f8f4

# https://github.com/aquasecurity/trivy/releases – tệp trivy_<phiên bản>_checksums.txt, dòng Linux-64bit.tar.gz
TRIVY_VERSION=v0.76.2
TRIVY_SHA256_LINUX_AMD64=bc0fc726e017b8927a62b2d3531d7a84ee01769daf5c99ed866dced54089fdbf

# Ảnh PostgreSQL cho các làn kiểm thử – cùng phiên bản chính với docker-compose.yml (postgres:17-alpine).
TEST_POSTGRES_IMAGE=postgres:17-alpine@sha256:d3244e8ce3f165ee3c93d9c4a4b1d0fe48b3a89e2287b717fdcbbde92d405065
