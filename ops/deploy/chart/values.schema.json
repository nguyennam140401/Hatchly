{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "appVersion", "replicas", "envFromSecret", "config"],
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" }
      }
    },
    "appVersion": { "type": "string" },
    "replicas": {
      "type": "object",
      "required": ["api", "worker"],
      "properties": {
        "api": { "type": "integer", "minimum": 1 },
        "worker": { "type": "integer", "minimum": 1 }
      }
    },
    "envFromSecret": { "type": "string" },
    "config": {
      "type": "object",
      "required": ["APP_ENV"],
      "properties": { "APP_ENV": { "enum": ["staging", "production"] } }
    }
  }
}
