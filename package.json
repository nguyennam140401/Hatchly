{
  "name": "app-root",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:shared": "pnpm --filter @app/shared build",
    "dev:api": "pnpm build:shared && pnpm --parallel --filter @app/shared --filter @app/server run \"/^(dev|dev:api)$/\"",
    "dev:worker": "pnpm build:shared && pnpm --parallel --filter @app/shared --filter @app/server run \"/^(dev|dev:worker)$/\"",
    "dev:web": "pnpm build:shared && pnpm --parallel --filter @app/shared --filter @app/web run dev",
    "build": "pnpm build:shared && pnpm --filter @app/server build && pnpm --filter @app/web build",
    "start:api": "pnpm --filter @app/server start:api",
    "start:worker": "pnpm --filter @app/server start:worker",
    "typecheck": "pnpm -r --no-bail --workspace-concurrency=1 exec tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "check:boundaries": "node tooling/check-boundaries.mjs",
    "check:secrets": "node tooling/scan-secrets.mjs",
    "check:web-bundle": "node tooling/check-web-bundle.mjs",
    "test": "pnpm -r test",
    "verify": "node tooling/verify.mjs",
    "db:up": "docker compose up -d postgres mailpit",
    "db:bootstrap": "pnpm --filter @app/server db:bootstrap",
    "db:setup": "pnpm --filter @app/server db:setup",
    "dev:seed-auth": "pnpm --filter @app/server dev:seed-auth",
    "staff": "pnpm --filter @app/server staff",
    "db:migrate": "pnpm --filter @app/server db:migrate",
    "db:check": "pnpm --filter @app/server db:check",
    "db:lint-migrations": "pnpm --filter @app/server db:lint-migrations",
    "db:generate": "pnpm --filter @app/server db:generate",
    "test:db": "pnpm --filter @app/server test:db",
    "test:queue": "pnpm --filter @app/server test:queue",
    "test:queue-soak": "pnpm --filter @app/server test:queue-soak",
    "test:e2e": "pnpm --filter @app/e2e test:e2e",
    "queue:sql": "pnpm --filter @app/server queue:sql"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
