# Phát hành từ chối driver `fake` – bộ kê khai này chỉ triển khai được khi đã có bản thật của ba cổng
# (PLATFORM_GATEWAY_DRIVER, AI_GATEWAY_DRIVER, NOTIFICATIONS_DRIVER). Trước đó `pnpm infra smoke production --infra-only`
# chỉ chạy các mục hạ tầng. KHÔNG đặt STAGING_ALLOW_FAKES hay FAKE_STATE_STORE ở đây (R15).
# 015: khi đã đặt khóa nhà cung cấp AI trong Secret (ANTHROPIC_API_KEY/OPENAI_API_KEY, xem infra/docs/06-bi-mat-va-khoa.md)
# thì thêm dòng AI_GATEWAY_DRIVER=real ở đây. KHÔNG đặt khóa trong tệp này.
APP_ENV=production
APP_VERSION=smoke
MAIL_FROM=no-reply@app.TODO-P6-base-domain
CORS_ORIGINS=https://app.TODO-P6-base-domain
WEB_ORIGINS=https://app.TODO-P6-base-domain
WEB_BASE_URL=https://app.TODO-P6-base-domain
S3_ENDPOINT=https://hcm03.vstorage.vngcloud.vn
S3_PUBLIC_ENDPOINT=https://hcm03.vstorage.vngcloud.vn
S3_REGION=HCM03
S3_BUCKET=app-media-production
